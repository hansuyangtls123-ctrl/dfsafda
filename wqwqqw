-- ==================== FULL CLEANUP ====================
local function fullCleanup()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    if antiVoidConn then pcall(function() antiVoidConn:Disconnect() end); antiVoidConn = nil end
    connections = {}
    pcall(function() workspace.Raycast = oldRaycast end)
    pcall(function() if fovCircle then fovCircle:Remove() end end)
    
    Wallbang = false; AntiVoid = false; Aimbot = false; AlwaysHit = false
    ConstantMode = false; Teleport = false; PrepMovement = false
end
fullCleanup()

-- ==================== BYPASS ====================
local function setupBypass()
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        local oldIndex = mt.__index
        setreadonly(mt, false)

        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            if method == "Kick" or method == "kick" then return end
            if method == "FireServer" then
                local argStr = tostring(args[1] or ""):lower()
                local keywords = {"detect", "cheat", "void", "ban", "anticheat", "report", "flag", "kick"}
                for _, kw in ipairs(keywords) do
                    if argStr:find(kw) then return end
                end
            end
            return oldNamecall(self, ...)
        end)

        mt.__index = newcclosure(function(self, key)
            if key == "Kick" then return nil end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end)
end
setupBypass()

-- ==================== VISIBILITY & TARGET ====================
local function isVisible(targetPlayer)
    if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("Head") then return false end
    local head = targetPlayer.Character.Head
    local origin = Camera.CFrame.Position
    local direction = (head.Position - origin)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, direction.Unit * (direction.Magnitude + 10), params)
    return not result or result.Instance:IsDescendantOf(targetPlayer.Character)
end

local function getNearestEnemy()
    local closest, dist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local mag = (plr.Character.Head.Position - Camera.CFrame.Position).Magnitude
                if mag < AimFOV then
                    local visible = Wallbang or isVisible(plr)
                    if visible and mag < dist then
                        dist = mag
                        closest = plr
                    end
                end
            end
        end
    end
    return closest
end

-- ==================== SILENT AIM ====================
workspace.Raycast = newcclosure(function(ws, origin, direction, params)
    if AlwaysHit and target and target.Character and target.Character:FindFirstChild("Head") then
        local shouldApply = ConstantMode or Wallbang
        if shouldApply then
            local head = target.Character.Head.Position
            local root = target.Character:FindFirstChild("HumanoidRootPart")
            local vel = root and root.Velocity or Vector3.new()
            local distance = (head - origin).Magnitude
            local predictionFactor = math.clamp(distance / 420, 0.02, 0.1)
            local predicted = head + vel * predictionFactor
            local newDir = (predicted - origin).Unit * 2500
            return oldRaycast(ws, origin, newDir, params)
        end
    end
    return oldRaycast(ws, origin, direction, params)
end)

